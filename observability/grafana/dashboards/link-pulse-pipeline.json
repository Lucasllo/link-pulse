{
  "uid": "link-pulse-pipeline",
  "title": "Link Pulse — Pipeline de cliques",
  "description": "Saúde do pipeline de cliques: publisher, stream do Valkey, consumer e gravação no MongoDB.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "tags": ["link-pulse"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lag do consumer",
      "description": "Entradas do stream ainda não entregues ao grupo de consumidores. NaN (o Valkey não sabe calcular, por exemplo depois de entradas apagadas) aparece como indefinido (decisão 02-08). max() e nunca sum(): o valor é do grupo, e cada réplica publica o mesmo número.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 10000 }] },
          "mappings": [{ "type": "special", "options": { "match": "nan", "result": { "text": "indefinido", "index": 0 } } }]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_stream_lag)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pendentes (PEL)",
      "description": "Entradas entregues ao grupo e ainda sem ACK (lista de pendentes do Valkey). Valor do grupo: max(), nunca sum().",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 10000 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_stream_pending)",
          "legendFormat": "pendentes"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tamanho do stream",
      "description": "Entradas guardadas no stream de cliques (XLEN), limitado por MAXLEN aproximado. Valor do stream: max(), nunca sum().",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_stream_length)",
          "legendFormat": "entradas"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fila do publisher",
      "description": "Cliques esperando o XADD na fila em memória do publisher (a réplica mais cheia). Fila cheia descarta o clique (publish rejected).",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_publish_queue)",
          "legendFormat": "fila"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lag e pendentes",
      "description": "Lag (ainda não entregue ao grupo) e pendentes (entregue, sem ACK). Lag NaN aparece como indefinido. As duas são gauges do grupo: max().",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "mappings": [{ "type": "special", "options": { "match": "nan", "result": { "text": "indefinido", "index": 0 } } }]
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_stream_lag)",
          "legendFormat": "lag"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(linkpulse_clicks_stream_pending)",
          "legendFormat": "pendentes"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Publicados x gravados por segundo",
      "description": "Cliques publicados no stream (XADD aceito) e cliques gravados no MongoDB, por segundo. Em regime as duas linhas andam juntas; gravados abaixo de publicados por muito tempo indica consumer atrasado.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(linkpulse_clicks_publish_total{result=\"published\"}[$__rate_interval]))",
          "legendFormat": "publicados/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(linkpulse_clicks_persisted_total[$__rate_interval]))",
          "legendFormat": "gravados/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Descartados",
      "description": "Cliques perdidos no intervalo. rejected: fila do publisher cheia. failed: XADD falhou (Valkey fora). lost: entradas pendentes que sumiram do stream (aparadas pelo MAXLEN ou apagadas) antes de gravadas. invalid: entradas malformadas confirmadas sem gravar.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (increase(linkpulse_clicks_publish_total{result=~\"rejected|failed\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(linkpulse_clicks_lost_total[$__rate_interval]))",
          "legendFormat": "lost"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(linkpulse_clicks_invalid_total[$__rate_interval]))",
          "legendFormat": "invalid"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duplicados, reclaim e erros",
      "description": "duplicados: entrega repetida de cliques que já estavam no MongoDB (não gravados de novo). reclaim: entradas presas na PEL tomadas de volta (XCLAIM). erros: ciclos do loop do consumer que falharam (por exemplo, MongoDB fora).",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(linkpulse_clicks_duplicates_total[$__rate_interval]))",
          "legendFormat": "duplicados"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(linkpulse_clicks_claimed_total[$__rate_interval]))",
          "legendFormat": "reclaim"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(linkpulse_clicks_consumer_errors_total[$__rate_interval]))",
          "legendFormat": "erros"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gravação do lote (média)",
      "description": "Tempo médio de cada insertAll do lote no MongoDB, separado por resultado (success ou failure).",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(linkpulse_clicks_consumer_write_seconds_sum[$__rate_interval])) / sum by (outcome) (rate(linkpulse_clicks_consumer_write_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
